# CognoDB connection details.
#
# Copy this file to `.env.development` and fill in the values from the
# credentials file CognoDB provides when the instance is created:
#
#   cp .env.example .env.development
#
# Real credentials are gitignored and never committed. On Vercel these same
# four variables are set in the project's Environment Variables settings.

# Bolt connection string. `bolt+s://` is Bolt over TLS, which CognoDB requires.
NEO4J_URI=bolt+s://<your-instance-id>.databases.cognodb.com

NEO4J_USERNAME=cognodb
NEO4J_PASSWORD=<your-password>

# Neo4j-compatible servers expose a default database named `neo4j`.
NEO4J_DATABASE=neo4j
